        {
          "info": {
            "name": "List events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.flatfile.com/v1/events",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "environmentId",
                "value": "",
                "type": "query",
                "description": "Filter by environment"
              },
              {
                "name": "spaceId",
                "value": "",
                "type": "query",
                "description": "Filter by space"
              },
              {
                "name": "domain",
                "value": "",
                "type": "query",
                "description": "Filter by event domain"
              },
              {
                "name": "topic",
                "value": "",
                "type": "query",
                "description": "Filter by event topic"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "Filter by event timestamp"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of results to return in a page (default 10)"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "Based on pageSize, which page of results to return"
              },
              {
                "name": "includeAcknowledged",
                "value": "",
                "type": "query",
                "description": "Include acknowledged events"
              }
            ]
          },
          "docs": "Event topics that the Flatfile Platform emits."
        },
        {
          "info": {
            "name": "Create an event",
            "type": "http"
