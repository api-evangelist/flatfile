                "description": "The event id"
              }
            ]
          },
          "docs": "Get an event"
        },
        {
          "info": {
            "name": "Acknowledge an event",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.x.flatfile.com/v1/events/:eventId/ack",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "The event id"
              }
            ]
          },
          "docs": "Acknowledge an event"
        },
        {
          "info": {
            "name": "Get subscription credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.flatfile.com/v1/subscription",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "scope",
                "value": "",
                "type": "query",
                "description": "The resource ID of the event stream (space or environment id)"
              },
              {
                "name": "spaceId",
                "value": "",
                "type": "query",
                "description": "The space ID of the event stream"
              }
            ]
          },
          "docs": "Get a token which can be used to subscribe to events for this space"
        }
