                "name": "spaceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of files to return in a page (default 20)"
              },
              {
                "name": "pageNumber",
                "value": "",
