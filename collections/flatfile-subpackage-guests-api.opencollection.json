                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "guestId",
                "value": "",
                "type": "path",
                "description": "ID of guest to return"
              },
              {
                "name": "spaceId",
                "value": "",
                "type": "query",
                "description": "ID of space to remove guest access from. If not provided, guest will be completely deleted."
