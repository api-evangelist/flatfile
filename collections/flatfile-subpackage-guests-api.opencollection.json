            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.flatfile.com/v1/guests",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "spaceId",
                "value": "",
                "type": "query",
                "description": "ID of space to return"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Email of guest to return"
              }
            ]
          },
          "docs": "Returns all guests"
        },
        {
