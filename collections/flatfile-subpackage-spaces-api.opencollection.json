              {
                "name": "namespace",
                "value": "",
                "type": "query",
                "description": "Search by namespace"
              },
              {
                "name": "archived",
                "value": "",
                "type": "query",
                "description": "Flag to include archived spaces"
              },
              {
                "name": "sortField",
