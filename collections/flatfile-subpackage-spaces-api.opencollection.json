                "description": "Based on pageSize, which page of records to return"
              },
              {
                "name": "app",
                "value": "",
                "type": "query",
                "description": "Filter by appId"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search query for spaces"
