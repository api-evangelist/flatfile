{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Reference subpackage_accounts subpackage_views API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "subpackage_views",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List views by Sheet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.flatfile.com/v1/views",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "sheetId",
                "value": "",
                "type": "query",
                "description": "The associated sheet ID of the view."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Number of prompts to return in a page (default 10)"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query",
                "description": "Based on pageSize, which page of prompts to return"
              }
            ]
          },
          "docs": "Returns all views for the sheet"
        },
        {
          "info": {
            "name": "Create a view",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.x.flatfile.com/v1/views",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a new view to the space"
        },
        {
          "info": {
            "name": "Get a view",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.x.flatfile.com/v1/views/:viewId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "viewId",
                "value": "",
                "type": "path",
                "description": "ID of view to return"
              }
            ]
          },
          "docs": "Returns a single view"
        },
        {
          "info": {
            "name": "Update a view",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.x.flatfile.com/v1/views/:viewId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "viewId",
                "value": "",
                "type": "path",
                "description": "ID of view to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a single view"
        },
        {
          "info": {
            "name": "Delete a view",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.x.flatfile.com/v1/views/:viewId",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "X-Disable-Hooks",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "viewId",
                "value": "",
                "type": "path",
                "description": "ID of view to delete"
              }
            ]
          },
          "docs": "Deletes a single view"
        }
      ]
    }
  ],
  "bundled": true
}